#ifndef VTPrefixHeader_pch
#define VTPrefixHeader_pch
#import <MBProgressHUD/MBProgressHUD.h>
#import <VTMProductLib/VTMProductLib.h>
#import "VTBLEUtils.h"
#import "VTMProductURATUtils.h"
#import <Masonry/Masonry.h>
#import "VTCOMMPresenter.h"

// ⚠️ 下面这些前缀**不要**用来做设备路由或扫描过滤。
//
// 路由与过滤的唯一依据是 VTMDeviceRouting 的前缀表，那张表和 SDK 内部
// VTMBLEDevice.m 的识别链逐条对齐。这里的常量是 Demo 早期留下的，其中几个
// 和 SDK 实际使用的值不一致（对比见 Distribution/README.md）：
//
//   ER1_ShowPre         @"ER1 "        SDK 是 @"ER1"     —— 漏掉 ER1S / ER1-W / ER1-L
//   VisualBeat_ShowPre  @"VisualBeat " SDK 是 @"VBeat"   —— 永远匹配不到真实设备
//   SA8W                @"SA-8W"       SDK 是 @"S8-AW "  —— 字符顺序不同
//
// 目前只有 ECG/VTMECGMenuVC.m 还在用 ER1_ShowPre 和 VisualBeat_ShowPre 做
// UI 功能开关，保留原值以免改变那里的现有行为。

//ECG
#define ER1_ShowPre @"ER1 " //ER1
#define VisualBeat_ShowPre @"VisualBeat " //VisualBeat
#define ER2_ShowPre @"ER2" //ER2
#define DuoEK_ShowPre @"DuoEK " //DuoEK

//BP
#define BP2_ShowPre @"BP2" //BP2
#define BP2A_ShowPre @"BP2A" //BP2A

//Scale
#define LeS1_ShowPre @"le S1-" //le S1

// ER3
#define ER3_ShowPre @"Lepod" //ER3

#define O2RingS @"O2Ring S" // II O2Ring
#define SA8W @"SA-8W" 

// Include any system framework and library headers here that should be included in all compilation units.
// You will also need to set the Prefix Header build setting of one or more of your targets to reference this file.

#endif /* VTPrefixHeader_pch */
